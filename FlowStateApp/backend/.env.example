# AWS Configuration
# ==================
# NEVER commit your actual credentials!
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# Application Configuration
# =========================
ENV=development
LOG_LEVEL=INFO

# CORS Configuration
# ==================
# Comma-separated list of allowed origins
# Example: https://app.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
# ========
DYNAMODB_ENDPOINTS_TABLE=FlowState_Endpoints
DYNAMODB_AUTH_TABLE=FlowState_Auth

# Security
# ========
# Token TTL in seconds (default: 86400 = 24 hours)
TOKEN_TTL=86400

# Monitoring
# ==========
# Monitoring loop interval in seconds
MONITOR_INTERVAL=10
